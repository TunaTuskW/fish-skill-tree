#!/bin/sh
# ==============================================================================
# Git Pre-Commit Hook: Zero-Leak & Zero-Malware Enforcement
# ==============================================================================

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$ROOT_DIR" ]; then
    echo "Error: Not a git repository." >&2
    exit 1
fi

# 1. Filename Guard: Check for forbidden sensitive filenames in staged index
STAGED_FILES=$(git diff --cached --name-only)
for f in $STAGED_FILES; do
    base=$(basename "$f")
    if [ "$base" = ".env" ] || echo "$base" | grep -Eq '^\.env\..*|^auth\.json$|^credentials\.json$'; then
        echo "ALERT: Forbidden sensitive file staged for commit: $f" >&2
        echo "Commit aborted by Zero-Leak pre-commit hook." >&2
        exit 1
    fi
done

# 2. Secret Scanner Execution
SCANNER=""
if [ -n "$E2E_SCANNER_PATH" ] && [ -f "$E2E_SCANNER_PATH" ]; then
    SCANNER="$E2E_SCANNER_PATH"
elif [ -f "$ROOT_DIR/[skill]/sensitive-data-guard/scripts/scan_secrets.py" ]; then
    SCANNER="$ROOT_DIR/[skill]/sensitive-data-guard/scripts/scan_secrets.py"
elif [ -f "$ROOT_DIR/tests/harness/reference_stubs/scan_secrets.py" ]; then
    SCANNER="$ROOT_DIR/tests/harness/reference_stubs/scan_secrets.py"
fi

if [ -n "$SCANNER" ]; then
    DIFF_CONTENT=$(git diff --cached)
    if [ -n "$DIFF_CONTENT" ]; then
        SCAN_OUT=$(echo "$DIFF_CONTENT" | python3 "$SCANNER" --stdin 2>&1)
        SCAN_EXIT=$?
        if [ "$SCAN_EXIT" -ne 0 ]; then
            echo "$SCAN_OUT" >&2
            echo "Zero-Leak Pre-Commit Veto: Staged changes contain sensitive credentials!" >&2
            exit 1
        fi
    fi
fi

# 3. AST Security Scanner Execution
AST_SCANNER=""
if [ -n "$E2E_AST_SCANNER_PATH" ] && [ -f "$E2E_AST_SCANNER_PATH" ]; then
    AST_SCANNER="$E2E_AST_SCANNER_PATH"
elif [ -f "$ROOT_DIR/scripts/scan_security_ast.py" ]; then
    AST_SCANNER="$ROOT_DIR/scripts/scan_security_ast.py"
elif [ -f "$ROOT_DIR/tests/harness/reference_stubs/scan_security_ast.py" ]; then
    AST_SCANNER="$ROOT_DIR/tests/harness/reference_stubs/scan_security_ast.py"
fi

if [ -n "$AST_SCANNER" ] && [ -n "$STAGED_FILES" ]; then
    AST_OUT=$(python3 "$AST_SCANNER" --staged 2>&1)
    AST_EXIT=$?
    if [ "$AST_EXIT" -ne 0 ]; then
        echo "$AST_OUT" >&2
        echo "Zero-Malware Pre-Commit Veto: AST security check failed on staged code!" >&2
        exit 1
    fi
fi

exit 0
