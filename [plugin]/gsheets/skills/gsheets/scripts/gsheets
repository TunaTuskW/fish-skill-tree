#!/bin/sh
# Launcher: installs the pinned CLI build for this machine on first use, then runs it.
TOOL=gsheets
PLUGIN_VERSION=0.0.6
CLI_VERSION=986250228
BASE_URL=https://storage.googleapis.com/antigravity-public/plugin/cli/$CLI_VERSION
# --- shared launcher logic; keep identical across plugins ---
set -eu

IS_FALLBACK=0
if [ -z "${ANTIGRAVITY_APP_DATA_DIR:-}" ]; then
  ANTIGRAVITY_APP_DATA_DIR="$HOME/.gemini/antigravity"
  IS_FALLBACK=1
fi

# Resolve the real script path, following symlinks if invoked via a shim.
TARGET_FILE=$0
while [ -L "$TARGET_FILE" ]; do
  TARGET_DIR=$(CDPATH= cd -- "$(dirname -- "$TARGET_FILE")" && pwd)
  TARGET_FILE=$(readlink "$TARGET_FILE")
  case "$TARGET_FILE" in
    /*) ;;
    *) TARGET_FILE="$TARGET_DIR/$TARGET_FILE" ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$TARGET_FILE")" && pwd)
REAL_SCRIPT="$SCRIPT_DIR/$TOOL"
PLUGIN_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/../../.." && pwd)
PLUGIN_DIR_NAME=$(basename -- "$PLUGIN_DIR")
BIN_DIR="$ANTIGRAVITY_APP_DATA_DIR/plugin_data/$PLUGIN_DIR_NAME/bin"
TARGET="$BIN_DIR/$TOOL-$CLI_VERSION"

# Self-register into Antigravity's bin directory (already in PATH for agent)
SHIM="$ANTIGRAVITY_APP_DATA_DIR/bin/$TOOL"

if [ ! -e "$SHIM" ]; then
  mkdir -p "$ANTIGRAVITY_APP_DATA_DIR/bin"
  if ln -sf "$REAL_SCRIPT" "$SHIM" 2>/dev/null && [ "$IS_FALLBACK" = "0" ]; then
    echo "Registered '$TOOL' into PATH ($SHIM). It can now be run directly." >&2
  fi
fi

# --- Cryptographic Integrity Verification ---
verify_sha256() {
  _file="$1"
  _expected="$2"
  _actual=""
  if command -v sha256sum >/dev/null 2>&1; then
    _actual=$(sha256sum "$_file" | awk '{print $1}')
  elif command -v shasum >/dev/null 2>&1; then
    _actual=$(shasum -a 256 "$_file" | awk '{print $1}')
  elif command -v openssl >/dev/null 2>&1; then
    _actual=$(openssl dgst -sha256 "$_file" | awk '{print $NF}')
  elif command -v python3 >/dev/null 2>&1; then
    _actual=$(python3 -c "import hashlib, sys; print(hashlib.sha256(open(sys.argv[1],'rb').read()).hexdigest())" "$_file")
  else
    echo "error: no sha256 verification tool found (sha256sum, shasum, openssl, python3)" >&2
    return 1
  fi
  if [ "$_actual" != "$_expected" ]; then
    echo "error: SHA-256 integrity verification failed for $_file" >&2
    echo "  expected: $_expected" >&2
    echo "  actual:   $_actual" >&2
    return 1
  fi
  return 0
}

case "$(uname -s)" in
  Linux) OS=linux ;;
  Darwin) OS=darwin ;;
  *) echo "error: unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac
case "$(uname -m)" in
  x86_64 | amd64) ARCH=x86_64 ;;
  arm64 | aarch64) ARCH=arm64 ;;
  *) echo "error: unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

case "${OS}_${ARCH}" in
  darwin_arm64)  EXPECTED_SHA256="dd1e7f565b3f9fd8add24dc29142710888cfc75db88e78e4a4f8674960ccf7f6" ;;
  darwin_x86_64) EXPECTED_SHA256="d05b59813b70d0afc82a00e2466974f5feeb0db2febe734879611d359415d5cf" ;;
  linux_arm64)   EXPECTED_SHA256="b1a651c43a9c88e4637e1b7902f52f98c4a0c8769d7433ed32028bf22aef7487" ;;
  linux_x86_64)  EXPECTED_SHA256="17e9613e23e6b8d379f1da59e8f95e7732eb77317a93fccca33f456d956afe30" ;;
  *) echo "error: unsupported platform: ${OS}_${ARCH}" >&2; exit 1 ;;
esac

# Verify pre-existing cached binary integrity; purge if invalid
if [ -f "$TARGET" ]; then
  if ! verify_sha256 "$TARGET" "$EXPECTED_SHA256" 2>/dev/null; then
    rm -f "$TARGET"
  fi
fi

if [ ! -x "$TARGET" ]; then
  mkdir -p "$BIN_DIR"
  rm -f "$BIN_DIR/$TOOL"-*
  TMP="$BIN_DIR/.$TOOL.tmp.$$"
  if ! curl -fsSL "$BASE_URL/${OS}_${ARCH}/$TOOL" -o "$TMP"; then
    rm -f "$TMP"
    echo "error: failed to download $BASE_URL/${OS}_${ARCH}/$TOOL" >&2
    exit 1
  fi
  if ! verify_sha256 "$TMP" "$EXPECTED_SHA256"; then
    rm -f "$TMP"
    echo "error: downloaded binary failed checksum verification" >&2
    exit 1
  fi
  chmod +x "$TMP"
  mv -f "$TMP" "$TARGET"
fi

exec "$TARGET" "$@"
