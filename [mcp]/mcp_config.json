{
  "mcpServers": {
    "codegraph": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "davinci-resolve": {
      "command": "python3",
      "args": [
        "./[mcp]/mcp_servers/davinci-resolve-mcp/server.py"
      ],
      "disabled": true
    },
    "gmp-code-assist": {
      "serverUrl": "https://mapscodeassist.googleapis.com/mcp"
    },
    "legalzoom": {
      "command": "python3",
      "args": [
        "./[mcp]/mcp_servers/legalzoom/bridge.py"
      ]
    }
  }
}
